{
  "manifest_version": 3,
  "name": "SubSeek: Search Plex Subtitles & Jump to Any Scene",
  "short_name": "SubSeek",
  "description": "Find any scene in your Plex movies by searching what was said. Type a quote, click the line, and jump straight to that moment.",
  "background": { "service_worker": "background.bundle.js" },
  "permissions": ["storage", "activeTab"],
  "action": {
    "default_title": "Open SubSeek",
    "default_icon": "icon-192.png"
  },
  "icons": {
    "192": "icon-192.png"
  },
  "content_scripts": [
    {
      "matches": ["https://app.plex.tv/*"],
      "js": ["contentScript.bundle.js"],
      "css": ["content.styles.css"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "content.styles.css",
        "icon-34.png",
        "icon-192.png",
        "SubSeekLogo.png",
        "05d2067aef6ec351ad62.png",
        "7e995521288a15f3d8ca.png"
      ],
      "matches": ["https://app.plex.tv/*"]
    }
  ]
}
